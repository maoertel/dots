model = "gpt-5.4"
model_reasoning_effort = "high"

[mcp_servers.commercetools-docs]
url = "https://docs.commercetools.com/apis/mcp"

[mcp_servers.google-calendar]
args = ["mcp", "--services", "calendar"]
command = "gws"

[mcp_servers.omai-agatha-mcp_agatha]
args = ["mcp"]
command = "oktapus"

[mcp_servers.omai-atlassian_atlassian]
url = "https://mcp.atlassian.com/v1/mcp"

[mcp_servers.omai-personal_circleci]
args = ["mcp", "start"]
command = "circleci"

[mcp_servers.omai-personal_leapsome]
args = ["{{ .chezmoi.homeDir }}/Documents/Projekte/leapsome-mcp/dist/index.js"]
command = "node"

[mcp_servers.omai-personal_obsidian]
args = ["obsidian-mcp-server"]
command = "npx"

[mcp_servers.omai-personal_obsidian.env]
OBSIDIAN_API_KEY = "{{ .obsidian_api_key }}"
OBSIDIAN_BASE_URL = "https://127.0.0.1:27124"
OBSIDIAN_ENABLE_CACHE = "true"
OBSIDIAN_VERIFY_SSL = "false"

[mcp_servers.omai-personal_slack]
command = "{{ .chezmoi.homeDir }}/Documents/Projekte/slack-personal-mcp/target/release/slack-personal-mcp"

[notice.model_migrations]
"gpt-5.3-codex" = "gpt-5.4"
"gpt-5.4" = "gpt-5.5"

[plugins."google-drive@openai-curated"]
enabled = true

[projects."{{ .chezmoi.homeDir }}"]
trust_level = "trusted"

[projects."{{ .chezmoi.homeDir }}/Development/claude"]
trust_level = "trusted"

[projects."{{ .chezmoi.homeDir }}/Documents/Projekte/agentgateway"]
trust_level = "trusted"

[projects."{{ .chezmoi.homeDir }}/Documents/Projekte/oh-my-ai-shell"]
trust_level = "trusted"

[projects."{{ .chezmoi.homeDir }}/Documents/Projekte/oktapus"]
trust_level = "trusted"

[tui]
status_line = ["model-with-reasoning", "context-remaining", "current-dir"]

[tui.model_availability_nux]
"gpt-5.5" = 4
