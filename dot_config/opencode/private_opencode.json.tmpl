{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "omai-agatha-mcp:agatha": {
      "command": [
        "oktapus",
        "mcp"
      ],
      "type": "local"
    },
    "omai-atlassian:atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "omai-personal:circleci": {
      "command": [
        "circleci",
        "mcp",
        "start"
      ],
      "type": "local"
    },
    "omai-personal:leapsome": {
      "command": [
        "node",
        "{{ .chezmoi.homeDir }}/Documents/Projekte/leapsome-mcp/dist/index.js"
      ],
      "type": "local"
    },
    "omai-personal:obsidian": {
      "command": [
        "npx",
        "obsidian-mcp-server"
      ],
      "environment": {
        "OBSIDIAN_API_KEY": "{{ .obsidian_api_key }}",
        "OBSIDIAN_BASE_URL": "https://127.0.0.1:27124",
        "OBSIDIAN_ENABLE_CACHE": "true",
        "OBSIDIAN_VERIFY_SSL": "false"
      },
      "type": "local"
    },
    "omai-personal:slack": {
      "command": [
        "{{ .chezmoi.homeDir }}/Documents/Projekte/slack-personal-mcp/target/release/slack-personal-mcp"
      ],
      "type": "local"
    }
  },
  "permission": {
    "bash": "ask",
    "edit": "ask",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "question": "allow",
    "read": "allow",
    "skill": "ask",
    "task": "ask",
    "webfetch": "ask",
    "websearch": "allow"
  },
  "provider": {
    "amazon-bedrock": {
      "options": {
        "profile": "ctp-aws-playground-eu",
        "region": "eu-central-1"
      }
    },
    "ct-gateway": {
      "models": {
        "claude-haiku-5-5": {
          "attachment": true,
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "Claude Haiku 5.5 (agatha, 1M)",
          "reasoning": true,
          "tool_call": true
        },
        "claude-opus-5-5": {
          "attachment": true,
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "Claude Opus 5.5 (agatha, 1M)",
          "reasoning": true,
          "tool_call": true
        },
        "claude-sonnet-5-5": {
          "attachment": true,
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "Claude Sonnet 5.5 (agatha, 1M)",
          "reasoning": true,
          "tool_call": true
        }
      },
      "name": "commercetools agentgateway (Claude)",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "apiKey": "ignored",
        "baseURL": "http://127.0.0.1:8765/v1"
      }
    },
    "ct-gateway-gemini": {
      "models": {
        "google/gemini-3.8-flash": {
          "attachment": true,
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "Gemini 3.8 Flash (agatha, 1M)",
          "reasoning": true,
          "tool_call": true
        },
        "google/gemini-4-argon": {
          "attachment": true,
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "Gemini 4 Argon (agatha, 1M)",
          "reasoning": true,
          "tool_call": true
        }
      },
      "name": "commercetools agentgateway (Gemini)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "ignored",
        "baseURL": "http://127.0.0.1:8765/v1",
        "headerTimeout": 120000,
        "headers": {
          "x-agatha-model-pool": "gemini"
        }
      }
    },
    "ollama": {
      "models": {
        "gpt-oss-32k": {
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "name": "GPT-OSS 20B (32k ctx, local)",
          "reasoning": true,
          "tool_call": true
        },
        "qwen3-coder-32k": {
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "name": "Qwen3 Coder 30B (32k ctx, local)",
          "tool_call": true
        }
      },
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      }
    }
  }
}